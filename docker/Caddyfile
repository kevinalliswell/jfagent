{$DOMAIN} {
	encode gzip

	# Application-level auth (JWT + admin role checks) protects /api/*;
	# Caddy only terminates TLS, proxies, and serves the SPA.
	@admin path /api/admin/*
	handle @admin {
		request_body {
			max_size 30MB
		}
		reverse_proxy api:3000
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
