# ---- LLM (OpenAI-compatible) ----
# Any OpenAI-compatible relay works (OpenAI, DeepSeek, Moonshot, xingwan/new-api relays...).
OPENAI_BASE_URL=https://xingwan.store/v1
OPENAI_API_KEY=replace_me
OPENAI_MODEL=replace_with_available_model
OPENAI_TIMEOUT_MS=25000

# ---- Accounts & auth ----
# Leave AUTH_DISABLED unset (or 0) in production: every user logs in with email+password.
# Set AUTH_DISABLED=1 only for single-operator local use (no login screen, admin powers).
#AUTH_DISABLED=0

# Token signing secret. If unset, a random secret is generated and persisted in the
# database on first boot (tokens survive restarts either way). Set explicitly when
# running multiple API replicas.
#JWT_SECRET=please_generate_a_long_random_string

# Bootstrap admin account, created automatically at startup when missing.
# The first self-registered user also becomes admin if these are unset.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password
#ADMIN_DISPLAY_NAME=管理员

# open  = anyone can self-register (each new user gets FREE_EXPORT_CREDITS)
# closed = only existing accounts can log in
REGISTRATION_MODE=open

# Free formal-export credits granted to each newly registered user.
FREE_EXPORT_CREDITS=1
